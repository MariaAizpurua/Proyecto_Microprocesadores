edumkiilib_empty.out: $(OBJS) $(CMD_SRCS) $(GEN_CMDS)
	@echo 'Building target: "$@"'
	@echo 'Invoking: MSP430 Linker'
	@echo 'Flags: -vmspx --data_model=restricted --use_hw_mpy=F5 --advice:hw_config=all --define=__MSP430FR5994__ --printf_support=minimal --silicon_errata=CPU21 --silicon_errata=CPU22 --silicon_errata=CPU40 -z --heap_size=160 --stack_size=160 --cinit_hold_wdt=on -i"C:/ti/ccs1031/ccs/ccs_base/msp430/include" -i"C:/ti/ccs1031/ccs/tools/compiler/ti-cgt-msp430_20.2.4.LTS/lib" -i"C:/ti/ccs1031/ccs/tools/compiler/ti-cgt-msp430_20.2.4.LTS/include" -i"C:/ti/ccs1031/ccs/ccs_base/msp430/lib/5xx_6xx_FRxx" -i"C:/ti/ccs1031/ccs/ccs_base/msp430/lib/FR59xx" --priority --reread_libs --warn_sections --use_hw_mpy=F5 --rom_model'
	$(shell echo -vmspx --data_model=restricted --use_hw_mpy=F5 --advice:hw_config=all --define=__MSP430FR5994__ --printf_support=minimal --silicon_errata=CPU21 --silicon_errata=CPU22 --silicon_errata=CPU40 -z --heap_size=160 --stack_size=160 --cinit_hold_wdt=on -i"C:/ti/ccs1031/ccs/ccs_base/msp430/include" -i"C:/ti/ccs1031/ccs/tools/compiler/ti-cgt-msp430_20.2.4.LTS/lib" -i"C:/ti/ccs1031/ccs/tools/compiler/ti-cgt-msp430_20.2.4.LTS/include" -i"C:/ti/ccs1031/ccs/ccs_base/msp430/lib/5xx_6xx_FRxx" -i"C:/ti/ccs1031/ccs/ccs_base/msp430/lib/FR59xx" --priority --reread_libs --warn_sections --use_hw_mpy=F5 --rom_model > "ccsLinker.opt")
	$(shell type "ccsObjs.opt" >> "ccsLinker.opt")
	"C:/ti/ccs1031/ccs/tools/compiler/ti-cgt-msp430_20.2.4.LTS/bin/cl430" -@"ccsLinker.opt" -o "edumkiilib_empty.out"
	@echo 'Finished building target: "$@"'
	@echo ' '

